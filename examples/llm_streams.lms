mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let a=llm.provider("mock",m.url()+"/v1","fixture-model").chat("hello").stream(true).send();let b=llm.provider("ollama",m.url(),"fixture-model").chat("hello").stream(true).send();assert_eq(a.contains("fixture"),true);assert_eq(b.contains("fixture"),true);assert_eq(a.output_tokens(),3);assert_eq(b.output_tokens(),3);
let csv="metric,value\n";
csv=csv+"OpenAI output tokens,"+str(a.output_tokens())+"\n";
csv=csv+"Ollama output tokens,"+str(b.output_tokens())+"\n";
file_write("data/llm_streams.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/llm_streams.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/llm_streams.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/llm_streams.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Both OpenAI and Ollama streaming fixtures\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/llm_streams.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/llm_streams-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/examples/llm_streams-plot.dslb;
assert(r.code==0);
assert(copy_file("images/llm_streams.png","docs/images/llm_streams.png"));
println("images/llm_streams.png");
