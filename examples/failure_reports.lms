mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let suite=curl.suite("negative contract");suite.test_request("wrong status",s.get("/status/503")).expect_status(200);suite.test_request("wrong body",s.get("/json")).expect_body("not present");let report=suite.report();assert_eq(report.failed(),2);report.junit("reports/failures.xml");report.html("reports/failures.html");report.save("reports/failures.json");file_write("reports/failures.tap",report.tap());
let csv="metric,value\n";
csv=csv+"failures detected,"+str(report.failed())+"\n";
csv=csv+"unexpected passes,"+str(report.passed())+"\n";
file_write("data/failure_reports.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/failure_reports.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/failure_reports.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/failure_reports.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"A failed contract produces actionable reports\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/failure_reports.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/failure_reports-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode build/examples/failure_reports-plot.dslb;
assert(r.code==0);
assert(copy_file("images/failure_reports.png","docs/images/failure_reports.png"));
println("images/failure_reports.png");
