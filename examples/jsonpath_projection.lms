mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let r=s.get("/json").send();let items=r.json("$.items[*]");assert_eq(items.count(),3);assert_eq(items.nth(1).to_int(),2);
assert_eq(r.json("$.ok").exists(),true);assert_eq(r.json("$.missing").exists(),false);
let csv="metric,value\n";
csv=csv+"user id,"+str(r.json("$.user.id").to_int())+"\n";
csv=csv+"item count,"+str(items.count())+"\n";
csv=csv+"second item,"+str(items.nth(1).to_int())+"\n";
file_write("data/jsonpath_projection.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/jsonpath_projection.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/jsonpath_projection.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/jsonpath_projection.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Typed JSONPath projections and predicates\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/jsonpath_projection.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/jsonpath_projection-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/examples/jsonpath_projection-plot.dslb;
assert(r.code==0);
assert(copy_file("images/jsonpath_projection.png","docs/images/jsonpath_projection.png"));
println("images/jsonpath_projection.png");
