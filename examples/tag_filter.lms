mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let suite=curl.suite("tag selection").filter("smoke");suite.test_request("smoke",s.get("/json")).tag("smoke").expect_status(200);suite.test_request("other",s.get("/status/500")).tag("slow").expect_status(200);let report=suite.report();assert_eq(report.passed(),1);assert_eq(report.skipped(),1);
let csv="metric,value\n";
csv=csv+"selected passed,"+str(report.passed())+"\n";
csv=csv+"skipped by tag,"+str(report.skipped())+"\n";
csv=csv+"selected failed,"+str(report.failed())+"\n";
file_write("data/tag_filter.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/tag_filter.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/tag_filter.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/tag_filter.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Select only the smoke contract\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/tag_filter.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/tag_filter-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/examples/tag_filter-plot.dslb;
assert(r.code==0);
assert(copy_file("images/tag_filter.png","docs/images/tag_filter.png"));
println("images/tag_filter.png");
