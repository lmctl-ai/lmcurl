mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let anon=s.get("/auth/basic").send();let auth=s.get("/auth/basic").basic("demo","demo").send();
assert_eq(anon.status(),401);assert_eq(auth.status(),200);
let csv="metric,value\n";
csv=csv+"anonymous status,"+str(anon.status())+"\n";
csv=csv+"authenticated status,"+str(auth.status())+"\n";
file_write("data/auth_boundary.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/auth_boundary.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/auth_boundary.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/auth_boundary.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Anonymous and authenticated access\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/auth_boundary.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/auth_boundary-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode build/examples/auth_boundary-plot.dslb;
assert(r.code==0);
assert(copy_file("images/auth_boundary.png","docs/images/auth_boundary.png"));
println("images/auth_boundary.png");
