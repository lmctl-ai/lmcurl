# One LLM call (OpenAI-style chat completion) in one script file (EXPERIMENTAL _dsl_ proof of concept, R22).
# URL, model and prompt are `${}` literals; the API key comes from the HOST environment through env("...") and is never in
# the script text or the bytecode. The reply text is extracted from the JSON by the host (json_text with a dotted path).
# Run from the repo root:
#   $LMSCRIPT_BIN examples/llm.lms build/llm.dslb [URL] [MODEL] [PROMPT] [KEY_VAR]
#   POC_CURL_KEY=test-key build/curlhost --dsl build/llm.dslb --schema schema/curl.dsl.json
# Defaults target the local mock (node tools/mock-server.mjs 8080). For a live call: URL https://api.openai.com/v1/chat/completions,
# KEY_VAR OPENAI_API_KEY and POC_CURL_LIVE=1 in test.sh; the test never does that unless both are set.
out = ARGV.len() > 0 ? ARGV[0] : "build/llm.dslb";
url = ARGV.len() > 1 ? ARGV[1] : "http://127.0.0.1:8080/v1/chat/completions";
model = ARGV.len() > 2 ? ARGV[2] : "mock-mini";
prompt = ARGV.len() > 3 ? ARGV[3] : "Say hello in five words.";
key_var = ARGV.len() > 4 ? ARGV[4] : "POC_CURL_KEY";
body = json_stringify({model: model, messages: [{role: "system", content: "You are terse."}, {role: "user", content: prompt}], max_tokens: 64, temperature: 0});
program = _dsl_ schema="../schema/curl.dsl.json";
if (!has_env(${key_var})) {
  out.fail("set " + ${key_var} + " in the host environment (the key never enters the script)");
} else {
  let res = request()
    .method("POST")
    .url(${url})
    .header("Content-Type", "application/json")
    .header("Authorization", "Bearer " + env(${key_var}))
    .timeout_ms(30000)
    .max_bytes(1000000)
    .body(${body})
    .send();
  if (res.ok() && res.has_json("choices.0.message.content")) {
    out.print("model: " + res.json_text("model"));
    out.print("reply: " + res.json_text("choices.0.message.content"));
    out.print("tokens: " + res.json_text("usage.total_tokens"));
  } else if (res.has_json("error.message")) {
    out.fail("API error " + str(res.status()) + ": " + res.json_text("error.message"));
  } else {
    out.fail("unexpected response " + str(res.status()) + ": " + res.body());
  }
}
end _dsl_
mkdir(dirname(out));
savedsl(program, out);
println(f"wrote {out} (model {model}, key from ${key_var})");
