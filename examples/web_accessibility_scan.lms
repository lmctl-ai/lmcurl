# Scan basic labels, image alternatives and empty controls
# Offline: lmcurl downloads; lmhtml parses; lmplot/lmdraw renders.
mkdir("data"); mkdir("build"); mkdir("images"); mkdir("reports"); mkdir("docs/images");
for (path in ["build/web-ready.txt","build/web-stop.txt"]) { if (file_exists(path)) { remove_file(path); } }
write_file("data/web-requests.jsonl","");

fn check(ok, message) {
  if (!ok) { println(message); }
  assert(ok);
}
fn run_program(program, path) {
  savedsl(program, path);
  r = system ${dsl_cli(program)} --dsl ${path};
  if (r.code != 0) { println(r.stderr); }
  check(r.code == 0, "native stage failed: " + path);
  return r;
}
fn record_request(route, status, bytes) {
  append_file("data/web-requests.jsonl", json_stringify({route: route, status: status, bytes: bytes, completed_ms: now(), estimated_cost_usd: 0}) + "\n");
}
fn download(base, route, out, follow) {
  # Only caller-owned loopback fixtures: discovered external URLs are out of scope.
  check(starts_with(base, "http://127.0.0.1:"), "expected loopback mock URL");
  if (starts_with(route,base+"/site/")) { route=replace(route,base,""); }
  check(starts_with(route, "/site/") && !contains(route, ".."), "fixture route outside scope");
  p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let r=curl.session(${base}).get(${route}).proxy("").follow(${follow}).timeout(5000).limit(1048576).send();
r.save(${out});
file_write(${out + ".status"},str(r.status()));
file_write(${out + ".bytes"},str(r.bytes()));
file_write(${out + ".location"},r.header("location"));
end _dsl_
  run_program(p, out + ".dslb");
  status = json_parse(read_file(out + ".status"));
  bytes = json_parse(read_file(out + ".bytes"));
  record_request(route, status, bytes);
  return {status: status, bytes: bytes, path: out, location: read_file(out + ".location")};
}
fn serve_site() {
  p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let site=curl.mock();
site.serve("build/web-ready.txt","build/web-stop.txt",60000);
end _dsl_
  run_program(p,"build/web-server.dslb");
  return true;
}
fn wait_and_run() {
  for (i in range(0,600)) {
    if (file_exists("build/web-ready.txt")) { break; }
    sleep_ms(10);
  }
  check(file_exists("build/web-ready.txt"),"mock did not become ready");
  base=trim(read_file("build/web-ready.txt"));
  story(base);
  write_file("build/web-stop.txt","stop\n");
  return true;
}

fn story(base) {
x=download(base,"/site/a11y.html","data/a11y.html",true);check(x.status==200,"accessibility download");
p=_dsl_ cli="lmhtml" install="github:lmctl-ai/lmhtml@latest";
let d=html.load("data/a11y.html");let images=d.select("img");let inputs=d.select("input");let labels=d.select("label");
let missing_alt=0;let unlabeled=0;let empty_buttons=0;let empty_links=0;
for(i in range(0,images.len())){if(!images.at(i).has_attr("alt")){missing_alt=missing_alt+1;}}
for(i in range(0,inputs.len())){
 let n=inputs.at(i);let named=false;
 if(n.attr("type")=="hidden"){continue;}
 if(str_len(str_trim(n.attr("aria-label")))>0||str_len(str_trim(n.attr("title")))>0||n.parent().tag()=="label"){named=true;}
 for(j in range(0,labels.len())){if(str_len(n.attr("id"))>0&&labels.at(j).attr("for")==n.attr("id")){named=true;}}
 if(!named){unlabeled=unlabeled+1;}
}
let buttons=d.select("button");for(i in range(0,buttons.len())){let n=buttons.at(i);if(str_len(str_trim(n.text()))==0&&str_len(str_trim(n.attr("aria-label")))==0){empty_buttons=empty_buttons+1;}}
let links=d.select("a");for(i in range(0,links.len())){let n=links.at(i);if(str_len(str_trim(n.text()))==0&&str_len(str_trim(n.attr("aria-label")))==0){empty_links=empty_links+1;}}
assert_close(float(missing_alt),1.0,0.000001);assert_close(float(unlabeled),1.0,0.000001);
assert_close(float(empty_buttons),1.0,0.000001);assert_close(float(empty_links),1.0,0.000001);
file_write("data/web_accessibility_scan.csv","metric,value\nmissing alt,"+str(missing_alt)+"\nunlabeled input,"+str(unlabeled)+"\nempty button,"+str(empty_buttons)+"\nempty link,"+str(empty_links)+"\n");
end _dsl_
run_program(p,"build/a11y-parser.dslb");

}
parallel([serve_site(), wait_and_run()]);
events=read_lines("data/web-requests.jsonl"); request_count=0;
for (line in events) { if (!is_blank(line)) { request_count=request_count+1; } }
write_json("reports/web_accessibility_scan-cost.json",{mode:"offline-loopback",currency:"USD",price_table:{loopback_request_usd:0},example_cap_usd:0.02,hard_run_cap_usd:0.25,requests:request_count,estimated_cost_usd:0});
println("estimated cost: $0.0000 (loopback fixtures only)");

plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/web_accessibility_scan.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Scan basic labels, image alternatives and empty controls\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel 'observed count / labeled value'");
plot.cmd("plot 'data/web_accessibility_scan.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
run_program(plot,"build/web_accessibility_scan-plot.dslb");
assert(copy_file("images/web_accessibility_scan.png","docs/images/web_accessibility_scan.png"));
println("images/web_accessibility_scan.png");
