mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let r=s.post("/login").json("{\"username\":\"demo\",\"password\":\"demo\"}").send();r.save("reports/login.json");let saved=file_read("reports/login.json");let masked=0;let leaked=0;if(str_contains(saved,"[REDACTED]")){masked=1;}if(str_contains(saved,"fixture-token")){leaked=1;}assert_eq(masked,1);assert_eq(leaked,0);
let csv="metric,value\n";
csv=csv+"redaction verified,"+str(masked)+"\n";
csv=csv+"credential leaks,"+str(leaked)+"\n";
file_write("data/secret_redaction.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/secret_redaction.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/secret_redaction.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/secret_redaction.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Credentials stay out of saved artifacts\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/secret_redaction.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/secret_redaction-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode build/examples/secret_redaction-plot.dslb;
assert(r.code==0);
assert(copy_file("images/secret_redaction.png","docs/images/secret_redaction.png"));
println("images/secret_redaction.png");
