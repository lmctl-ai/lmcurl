mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let a=s.post("/users").json("{\"name\":\"Ada\"}").send();
assert_eq(a.status(),201);s.set("id",a.json("$.id").value());
let b=s.put("/users/{{id}}").json("{\"name\":\"Grace\"}").send();assert_eq(b.json("$.name").value(),"Grace");
let c=s.get("/users/{{id}}").send();assert_eq(c.status(),200);
let d=s.delete("/users/{{id}}").send();assert_eq(d.json("$.deleted").value(),"true");
let missing=s.get("/users/{{id}}").send();assert_eq(missing.status(),404);
let csv="metric,value\n";
csv=csv+"create HTTP,"+str(a.status())+"\n";
csv=csv+"update HTTP,"+str(b.status())+"\n";
csv=csv+"read HTTP,"+str(c.status())+"\n";
csv=csv+"after delete,"+str(missing.status())+"\n";
file_write("data/rest_crud.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/rest_crud.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/rest_crud.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/rest_crud.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"A user record through its complete lifecycle\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/rest_crud.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/rest_crud-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/examples/rest_crud-plot.dslb;
assert(r.code==0);
assert(copy_file("images/rest_crud.png","docs/images/rest_crud.png"));
println("images/rest_crud.png");
