mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let sample=llm.mock("fixture").chat("ping").sample(5,1.0);assert_eq(sample.len(),5);assert_close(sample.pass_rate("^pong$"),1.0,0.0001);
let csv="metric,value\n";
csv=csv+"samples,"+str(sample.len())+"\n";
csv=csv+"pass percentage,"+str(sample.pass_rate("^pong$")*100.0)+"\n";
csv=csv+"missing text percentage,"+str(sample.pass_rate("missing")*100.0)+"\n";
file_write("data/llm_sampling.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/llm_sampling.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/llm_sampling.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/llm_sampling.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Sampling reports measured prompt pass rates\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/llm_sampling.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/llm_sampling-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode build/examples/llm_sampling-plot.dslb;
assert(r.code==0);
assert(copy_file("images/llm_sampling.png","docs/images/llm_sampling.png"));
println("images/llm_sampling.png");
