mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let set=s.get("/cookies/set?theme=dark").send();assert_eq(set.cookie("theme"),"dark");
let r=s.get("/cookies").send();assert_eq(r.json("$.cookies.theme").value(),"dark");
let fresh=curl.session(m.url()).get("/cookies").send();assert_eq(fresh.json("$.cookies.theme").exists(),false);
let csv="metric,value\n";
csv=csv+"session cookies,"+str(r.json("$.cookies").count())+"\n";
csv=csv+"fresh client cookies,"+str(fresh.json("$.cookies").count())+"\n";
file_write("data/cookie_jar.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/cookie_jar.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/cookie_jar.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/cookie_jar.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"A session keeps cookies across requests\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/cookie_jar.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/cookie_jar-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/examples/cookie_jar-plot.dslb;
assert(r.code==0);
assert(copy_file("images/cookie_jar.png","docs/images/cookie_jar.png"));
println("images/cookie_jar.png");
