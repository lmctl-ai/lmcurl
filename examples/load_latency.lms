mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let one=curl.load(s.get("/json"),1,1.0,20);let two=curl.load(s.get("/json"),2,1.0,20);let four=curl.load(s.get("/json"),4,1.0,20);assert_eq(one.threshold(2000.0,0.0),true);assert_eq(two.threshold(2000.0,0.0),true);assert_eq(four.threshold(2000.0,0.0),true);
let csv="metric,value\n";
csv=csv+"one user p95 ms,"+str(one.p95_ms())+"\n";
csv=csv+"two users p95 ms,"+str(two.p95_ms())+"\n";
csv=csv+"four users p95 ms,"+str(four.p95_ms())+"\n";
file_write("data/load_latency.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/load_latency.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/load_latency.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/load_latency.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Virtual users and latency thresholds\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/load_latency.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/load_latency-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/examples/load_latency-plot.dslb;
assert(r.code==0);
assert(copy_file("images/load_latency.png","docs/images/load_latency.png"));
println("images/load_latency.png");
