mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _lmcode_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let suite=curl.suite("parallel").parallel(true);for(i in range(0,6)){suite.test_request("worker "+str(i),s.get("/delay/20")).expect_status(200);}let report=suite.report();assert_eq(report.passed(),6);assert_eq(report.failed(),0);report.csv("reports/parallel.csv");
let csv="metric,value\n";
csv=csv+"concurrent cases passed,"+str(report.passed())+"\n";
csv=csv+"failed cases,"+str(report.failed())+"\n";
file_write("data/parallel_checks.csv",csv);
m.stop();
end _lmcode_
r = run_lmcode(p);
require(r.ok,json_stringify(r));
plot = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/parallel_checks.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Independent checks run concurrently\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/parallel_checks.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _lmcode_
r = run_lmcode(plot);
require(r.ok,json_stringify(r));
assert(copy_file("images/parallel_checks.png","docs/images/parallel_checks.png"));
println("images/parallel_checks.png");
