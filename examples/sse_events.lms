mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let r=s.get("/sse").stream(true).send();assert_eq(r.status(),200);assert_eq(r.sse_count(),2);assert_eq(str_contains(r.body(),"[DONE]"),true);
let csv="metric,value\n";
csv=csv+"data events,"+str(r.sse_count())+"\n";
csv=csv+"payload bytes,"+str(r.bytes())+"\n";
file_write("data/sse_events.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/sse_events.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/sse_events.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/sse_events.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Event-stream data stays bounded and inspectable\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/sse_events.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/sse_events-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode build/examples/sse_events-plot.dslb;
assert(r.code==0);
assert(copy_file("images/sse_events.png","docs/images/sse_events.png"));
println("images/sse_events.png");
