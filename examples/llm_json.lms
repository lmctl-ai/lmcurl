mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let result=llm.mock("fixture").chat("Reply as JSON").json_mode(true).send();assert_eq(result.json_valid(),true);assert_eq(result.schema_valid("{\"type\":\"object\",\"required\":[\"ok\",\"answer\"]}"),true);
let csv="metric,value\n";
csv=csv+"answer,"+str(curl.query_json(result.text(),"$.answer").to_int())+"\n";
csv=csv+"fixture output tokens,"+str(result.output_tokens())+"\n";
file_write("data/llm_json.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/llm_json.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/llm_json.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/llm_json.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Structured completions have schema contracts\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/llm_json.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/llm_json-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode build/examples/llm_json-plot.dslb;
assert(r.code==0);
assert(copy_file("images/llm_json.png","docs/images/llm_json.png"));
println("images/llm_json.png");
