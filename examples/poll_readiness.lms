mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let suite=curl.suite("readiness");suite.test_request("ready",s.get("/poll/2")).expect_status(200).poll_json("$.ready","true",3,5);
let report=suite.report();assert_eq(report.failed(),0);let attempts=curl.query_json(report.json(),"$.cases[0].attempts").to_int();assert_eq(attempts,3);
let csv="metric,value\n";
csv=csv+"poll attempts,"+str(attempts)+"\n";
csv=csv+"passed cases,"+str(report.passed())+"\n";
file_write("data/poll_readiness.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/poll_readiness.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/poll_readiness.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/poll_readiness.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Poll assertions until the service is ready\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/poll_readiness.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/poll_readiness-plot.dslb");
r = system ${dsl_cli(plot)} --lmcode build/examples/poll_readiness-plot.dslb;
assert(r.code==0);
assert(copy_file("images/poll_readiness.png","docs/images/poll_readiness.png"));
println("images/poll_readiness.png");
