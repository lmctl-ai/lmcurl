mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let provider=llm.mock("fixture");let first=provider.chat("ping").max_tokens(8).cassette("data/prompt.cassette.json").send();let replay=provider.chat("ping").max_tokens(8).replay("data/prompt.cassette.json").send();assert_eq(first.text(),replay.text());assert_close(replay.estimated_cost(),0.0,0.00001);llm.ledger("reports/cost.json");
let csv="metric,value\n";
csv=csv+"recorded output tokens,"+str(first.output_tokens())+"\n";
csv=csv+"replayed output tokens,"+str(replay.output_tokens())+"\n";
file_write("data/llm_replay.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/llm_replay.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/llm_replay.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/llm_replay.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Recorded completions replay without credentials\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/llm_replay.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/llm_replay-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/examples/llm_replay-plot.dslb;
assert(r.code==0);
assert(copy_file("images/llm_replay.png","docs/images/llm_replay.png"));
println("images/llm_replay.png");
