mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let r=s.get("/gzip").send();assert_eq(r.status(),200);assert_eq(r.json("$.compressed").value(),"true");assert_eq(r.json("$.name").value(),"lmcurl");
let csv="metric,value\n";
csv=csv+"decoded bytes,"+str(r.bytes())+"\n";
csv=csv+"name length,"+str(str_len(r.json("$.name").value()))+"\n";
file_write("data/compression.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/compression.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/compression.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/compression.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Compressed responses are decoded before queries\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/compression.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/compression-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/examples/compression-plot.dslb;
assert(r.code==0);
assert(copy_file("images/compression.png","docs/images/compression.png"));
println("images/compression.png");
