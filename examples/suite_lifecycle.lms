mkdir("data"); mkdir("images"); mkdir("reports"); mkdir("build/examples"); mkdir("docs/images");

p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock();
let s=curl.session(m.url());
let suite=curl.suite("lifecycle").before(s.post("/login").json("{\"username\":\"demo\",\"password\":\"demo\"}")).after(s.get("/echo?teardown=yes"));suite.test_request("protected",s.get("/protected")).expect_status(200);let report=suite.report();assert_eq(report.failed(),0);assert_eq(report.passed(),3);
let csv="metric,value\n";
csv=csv+"setup test teardown passed,"+str(report.passed())+"\n";
csv=csv+"failed stages,"+str(report.failed())+"\n";
file_write("data/suite_lifecycle.csv",csv);
m.stop();
end _dsl_
savedsl(p,"build/examples/suite_lifecycle.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/suite_lifecycle.dslb;
if(r.code != 0){println(r.stdout);println(r.stderr);}
assert(r.code==0);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/suite_lifecycle.png",900,560);
plot.cmd("set datafile separator ','");
plot.cmd("set title \"Setup runs before protected checks\"");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.12,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.65");
plot.cmd("set xtics rotate by -15 font ',10'");
plot.cmd("set ylabel \"observed value\"");
plot.cmd("plot 'data/suite_lifecycle.csv' every ::1 using 0:2:xtic(1) with boxes lc rgb '#0969da', '' every ::1 using 0:2:(sprintf('%.3g',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
savedsl(plot,"build/examples/suite_lifecycle-plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/examples/suite_lifecycle-plot.dslb;
assert(r.code==0);
assert(copy_file("images/suite_lifecycle.png","docs/images/suite_lifecycle.png"));
println("images/suite_lifecycle.png");
